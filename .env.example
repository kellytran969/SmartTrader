# Copy to .env and fill in. Never commit real keys.
# Each service also reads its own variables; see README for the full table.

# --- market-data (Python/FastAPI, :8000) ---
PRICE_PROVIDER=simulated        # simulated | finnhub | alphavantage
FINNHUB_API_KEY=                # required only when PRICE_PROVIDER=finnhub
ALPHAVANTAGE_API_KEY=           # required only when PRICE_PROVIDER=alphavantage
REDIS_URL=                      # e.g. redis://localhost:6379/0 — optional L2 cache
QUOTE_TTL_L1=5
QUOTE_TTL_L2=30
PROVIDER_RATE_LIMIT_PER_SEC=10
PROVIDER_BURST=20
TICK_INTERVAL=1.0

# --- api (Express, :5000) ---
PORT=5000
MONGO_URI=mongodb://localhost:27017/smarttrader
JWT_SECRET=change-me-to-a-long-random-string
MARKET_DATA_URL=http://localhost:8000
STRIPE_SECRET_KEY=              # sk_test_... — leave empty for local stub mode
STRIPE_PUBLISHABLE_KEY=         # pk_test_... — leave empty for local stub mode

# --- client (Vite, :5173) ---
VITE_API_URL=http://localhost:5000
VITE_MARKET_DATA_WS=ws://localhost:8000/ws/ticks
